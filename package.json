{
    "name": "graph-viz",
    "version": "2.0.0",
    "description": "Interactive graph visualization of an Amplify Fusion tenant's JSON:API configuration",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
        "dev:server": "node --watch server/index.js",
        "dev:client": "vite",
        "build": "vite build",
        "start": "node server/index.js",
        "test": "node --test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "roots": "node scripts/extract-root-resources.mjs"
    },
    "license": "ISC",
    "dependencies": {
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-react": "^6.2.1",
        "concurrently": "^10.0.6",
        "d3-force-3d": "^3.0.6",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "force-graph": "^1.52.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "vite": "^8.3.5"
    },
    "overrides": {
        "minimatch": "^11.0.4"
    }
}
