# Copy to .env to configure the server (see README.md for every setting). Real environment variables win.

# PORT=8080
# HOST=127.0.0.1

# Restrict which tenants users can sign in to (recommended when the server is shared):
# ALLOWED_TENANT_HOSTS=*.fusion.example.com

# Only for tenants whose sign-in service isn't at services.<tenant domain>:
# SERVICES_URL=https://login.example.com
